{
  "name": "jarvis-vosk-piper-server",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "node server.js",
    "dev": "nodemon server.js",
    "setup:python": "node scripts/setup-python.mjs",
    "doctor": "node scripts/doctor.mjs",
    "check": "node --check server.js && node --check src/config.js && node --check src/services/function.js && node --check src/controllers/voice.controller.js && node --check src/routes/voice.routes.js && node --check scripts/setup-python.mjs",
    "test": "node --test tests/smoke.test.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "dotenv": "^16.6.1",
    "express": "^5.2.1",
    "multer": "^2.3.0",
    "node-llama-cpp": "^3.20.0",
    "tesseract.js": "^7.0.0",
    "ws": "^8.18.3"
  },
  "devDependencies": {
    "nodemon": "^3.1.10"
  },
  "allowScripts": {
    "node-llama-cpp@3.20.0": true,
    "tesseract.js@7.0.0": true
  }
}
